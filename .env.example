# Copy to .env (chmod 600). These stay on this machine: router credentials are never sent to WISPMap.

# From WISPMap → Admin → Collectors (the token is shown once when you add the collector)
WISPMAP_URL=https://wispmap.example.co.za
WISPMAP_TOKEN=wmc_xxxxxxxx_paste-the-token-here

# Read-only RouterOS user that exists on every router (group with read,api,test policies)
WISPMON_USER=wispmon
WISPMON_PASSWORD=change-me

# SNMP devices (non-MikroTik radios, switches, UPSs). Either v2c:
# SNMP_COMMUNITY=public
# or v3 (preferred; authPriv):
# SNMP_V3_USER=wispmap
# SNMP_V3_AUTH_PROTO=SHA          (SHA, SHA256, SHA512, MD5)
# SNMP_V3_AUTH_KEY=...
# SNMP_V3_PRIV_PROTO=AES          (AES, AES256, DES)
# SNMP_V3_PRIV_KEY=...
# Devices whose credential profile in WISPMap is e.g. "towers" use SNMP_COMMUNITY_TOWERS (or SNMP_V3_USER_TOWERS, ...).

# Optional: name shown on the Collectors page (Docker compose only)
# COLLECTOR_HOSTNAME=pop1-collector

# Optional: image tag (Docker compose only). Default "latest"; "0.3" stays on 0.3.x updates.
# COLLECTOR_TAG=0.3

# Optional: routers polled at the same time (default 64). Raise it for 1,000+ routers or many slow ones.
# WISPMAP_POLL_THREADS=64
